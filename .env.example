# =============================================================================
# Spariom CRM — Environment Configuration Template (.env.example)
# Duplicate this file as .env and fill in required secrets.
# =============================================================================

# Client-Side Supabase Configuration (Exposed to Vite browser bundle)
VITE_SUPABASE_URL=https://tivecvbokrkooaznfjdy.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-Side Supabase Configuration (Nitro / Node.js Server Functions)
SUPABASE_URL=https://tivecvbokrkooaznfjdy.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase Service Role Key (Server-Only, bypasses RLS for administrative user provisioning)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct / Pooler Database Connection String (Server-side migrations & seed scripts)
DATABASE_URL=postgresql://postgres.tivecvbokrkooaznfjdy:[DB-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# Application Branding and Ports
VITE_APP_NAME=Spariom CRM
PORT=3000
